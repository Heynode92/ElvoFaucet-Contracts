{
  "name": "elvo-faucet-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gasless Elvo Faucet distributor contracts for Robinhood Chain Testnet",
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0 <23"
  },
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile --build-profile production",
    "test": "node test/integration.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run compile && npm run test && npm run audit",
    "deploy:preflight:testnet": "node --env-file=.env scripts/preflight-robinhood-testnet.mjs",
    "deploy:testnet": "npm run compile && node --env-file=.env scripts/deploy-robinhood-testnet.mjs",
    "verify:testnet": "npm run compile && node --env-file=.env scripts/verify-robinhood-testnet.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "22.20.2",
    "ethers": "6.17.0",
    "hardhat": "3.16.0",
    "typescript": "5.9.2"
  }
}
